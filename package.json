{
  "name": "@bazulu1/n8n-nodes-matrix42-esm",
  "version": "0.7.0",
  "description": "n8n nodes for Matrix42 Enterprise Service Management (ESM): tickets, incidents, service requests, tasks, changes, approvals, workflows, attachments, assets and any data definition",
  "license": "MIT",
  "homepage": "https://github.com/bazn/n8n-nodes-matrix42-esm#readme",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "matrix42",
    "esm",
    "itsm",
    "service-desk",
    "servicedesk"
  ],
  "author": {
    "name": "Dominik Vogt",
    "email": "vogt.dom@gmail.com"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "npm run lint && npm test",
    "test": "n8n-node build && node --test test/unit/",
    "test:live": "n8n-node build && node test/live/run.cjs"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/Matrix42EsmApi.credentials.js",
      "dist/credentials/Matrix42EsmBasicApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Matrix42/Matrix42Esm.node.js",
      "dist/nodes/Matrix42EsmTrigger/Matrix42EsmTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "release-it": "^21.1.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bazn/n8n-nodes-matrix42-esm.git"
  },
  "bugs": {
    "url": "https://github.com/bazn/n8n-nodes-matrix42-esm/issues"
  },
  "engines": {
    "node": ">=20"
  }
}
